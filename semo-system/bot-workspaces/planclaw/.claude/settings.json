{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "semo context sync --out-dir ~/.openclaw-planclaw/workspace/memory 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "semo sessions push --bot-id planclaw --event start 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "semo sessions push --bot-id planclaw --event stop 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
