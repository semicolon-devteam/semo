{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "semo context sync --out-dir ~/.openclaw-reviewclaw/workspace/memory 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "semo sessions push --bot-id reviewclaw --event start 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "semo sessions push --bot-id reviewclaw --event stop 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
