# SEMO Project .gitignore

# === 의존성 ===
node_modules/
.pnpm-store/

# === 빌드 산출물 ===
dist/
build/
*.tsbuildinfo
packages/cli/*.tgz

# === 환경 설정 ===
.env
.env.local
.env.*.local
*.pem
credentials.json

# === IDE ===
.idea/
*.swp
*.swo

# === OS ===
.DS_Store
Thumbs.db

# === 로그 ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === 테스트 ===
coverage/
.nyc_output/

# === Claude Code ===
.claude/settings.local.json

# === 민감한 디렉토리 ===
core-db/
.next/

# === SEMO ===
.claude/*
!.claude/memory/
!.claude/memory/**
!.claude/rules/
!.claude/rules/**
!.claude/CLAUDE.md
!.claude/settings.json
*.agent-spec-last-rendered.json
semo-system/

# === 런타임 상태/캐시 ===
memory/
supabase/.branches/
supabase/.temp/
__pycache__/
*.pyc
packages/semo-meeting/.job-store/

# === 개인 메모 ===
packages/cli/PERSONAL_TESTING.md
증빙-*.md

# === 사고 방지 가드 ===
# 미확장 '~' (literal tilde) 로 잘못 생성되는 stray 디렉토리 — hermes 홈 사본 등 시크릿 유출 방지
/~/
# 클라우드 동기화 충돌 사본 (iCloud/Dropbox "filename 2.ext")
* 2.*
