{
  "display_information": {
    "name": "SemoBot",
    "description": "SEMO Incubator unified bot — Claude Code Channel bridge",
    "background_color": "#1a1a2e",
    "long_description": "Semicolon Orchestrate 인큐베이터 통합 봇. 프로젝트별 전용 Claude Code 세션과 연결되어, Phase 기반 자동 라우팅으로 PlanClaw/DesignClaw/WorkClaw/InfraClaw 등 전문 에이전트가 응답합니다."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "SemoBot",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:join",
        "channels:read",
        "chat:write",
        "chat:write.customize",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "reactions:read",
        "reactions:write",
        "users:read",
        "users:read.email",
        "files:read",
        "files:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.im",
        "message.groups",
        "reaction_added"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
