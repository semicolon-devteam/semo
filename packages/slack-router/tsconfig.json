{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "../..",
    "baseUrl": ".",
    "paths": {
      "../../agent-mailbox/src/*": ["../agent-mailbox/src/*"],
      "../../common/src/*": ["../common/src/*"]
    }
  },
  "include": ["src", "../agent-mailbox/src", "../common/src"],
  "exclude": ["../**/__tests__/**", "../**/dist/**"]
}
