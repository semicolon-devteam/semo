{
  "name": "@team-semicolon/semo-cli",
  "version": "4.18.49",
  "description": "semicolony CLI - AI Agent Orchestration Framework Installer",
  "main": "dist/bundle.js",
  "bin": {
    "semicolony": "dist/bundle.js",
    "semo": "dist/bundle.js",
    "semo-cli": "dist/bundle.js"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs && rm -rf dist/templates && cp -r src/templates dist/templates && xattr -cr dist/ 2>/dev/null || true",
    "build:tsc": "tsc",
    "bundle": "node scripts/bundle.mjs",
    "start": "node dist/bundle.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src/"
  },
  "keywords": [
    "semo",
    "cli",
    "ai-agent",
    "claude",
    "semicolon"
  ],
  "author": "Semicolon DevTeam",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semicolon-devteam/semo.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "cron-parser": "^4.9.0",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "smol-toml": "^1.6.1"
  },
  "optionalDependencies": {
    "@team-semicolon/semo-common": "*",
    "@team-semicolon/semo-discord-router": "*",
    "@team-semicolon/semo-kb-core": "*",
    "@team-semicolon/semo-kb-pg": "*",
    "@team-semicolon/semo-ops-store": "*",
    "pg": "^8.17.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.0",
    "@types/inquirer": "^8.2.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.16.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.4",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "migrations",
    "migrations-sqlite",
    "README.md",
    "PERSONAL_TESTING.md",
    "LICENSE",
    "NOTICE"
  ]
}
