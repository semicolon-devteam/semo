{
  "display_information": {
    "name": "Colony",
    "description": "SEMO Agent Factory builder — finds existing agents or proposes new ones.",
    "background_color": "#5b3aa6"
  },
  "features": {
    "bot_user": {
      "display_name": "Colony",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "files:write",
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "chat:write.public",
        "files:read",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "mpim:history",
        "mpim:read",
        "reactions:read",
        "reactions:write",
        "users:read",
        "channels:join",
        "search:read.files",
        "calls:read",
        "calls:write"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "reaction_added",
        "reaction_removed"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
